# ===================================================================
# Mindroot Platform Environment Variables Template
# Copy this file to '.env' and fill in your actual configuration values
# ===================================================================

# Secret key used for signing JWT authentication tokens
JWT_SECRET=CHANGE_ME

# Platform Administrator Credentials (change in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# PostgreSQL Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mindroot

# Demo Mode Gate (Set to 'true' for local hackathon demo and quick-fill test logins; 'false' in production)
DEMO_MODE=true

# Database Fail-Closed Policy:
# If DATABASE_URL is set, failed DB operations fail-closed with HTTP 503 by default.
ALLOW_UNSAFE_IN_MEMORY_FAILOVER=false

# WebRTC STUN/TURNS Relay Configuration (RFC 5766 / RFC 8656)
# Enterprise NAT & Campus Firewall traversal via TURNS on port 443 over TCP:
# Set your production TURN relay host and credentials:
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Alternatively, dynamic short-lived TURN credentials using HMAC-SHA1:
# TURN_SECRET=

# Backend API endpoint URL used by Frontend dev server & Docker build (LEAVE UNSET FOR LOCAL/LAN DEV; set only for production builds like Vercel)
# VITE_BACKEND_URL=http://localhost:3000

# The deployed frontend URL (e.g. https://yourapp.vercel.app). Used to restrict CORS and Socket.io connections in production.
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 Client ID (Free setup at https://console.cloud.google.com/apis/credentials)
# Set the exact same OAuth Client ID value for both Frontend and Backend
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# (Optional) Gemini API Key for contextual AI chat assistant
# GEMINI_API_KEY=your_gemini_api_key_here


