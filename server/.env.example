# PostgreSQL Database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindroot?schema=public

# Secret key used for signing JWT authentication tokens
JWT_SECRET=mindroot-dev-secret-key-change-in-prod

# The deployed frontend URL (e.g. https://yourapp.vercel.app). Used to restrict CORS and Socket.io connections in production.
FRONTEND_URL=http://localhost:5173

# Demo Mode Gate (Set to 'true' for local hackathon demo and quick-fill test logins; 'false' in production)
DEMO_MODE=true

# Database Fail-Closed Policy:
# If DATABASE_URL is set, failed DB operations fail-closed with HTTP 503 by default.
# Only set to 'true' if deliberately testing standalone offline mock mode without persistence.
ALLOW_UNSAFE_IN_MEMORY_FAILOVER=false

# WebRTC STUN/TURNS Relay Configuration (RFC 5766 / RFC 8656)
# Enterprise NAT & Campus Firewall traversal via TURNS on port 443 over TCP:
TURN_SERVER_URL=turns:turn.example.com:443?transport=tcp
TURN_USERNAME=mindroot_relay_user
TURN_CREDENTIAL=mindroot_relay_secret
# Alternatively, dynamic short-lived TURN credentials using HMAC-SHA1:
# TURN_SECRET=your_coturn_static_auth_secret

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Mailing System Configuration:
# Option 1: Gmail SMTP via App Password (Recommended - delivers to ANY email address with 0 domain setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Mindroot Learning <your_gmail_address@gmail.com>"

# Option 2: Resend Email Gateway (Requires verified custom domain to deliver to other emails)
RESEND_API_KEY=re_123456789_abcdefg
EMAIL_FROM=Mindroot Learning <onboarding@resend.dev>

# (Optional) Gemini API Key for contextual AI chat assistant
# GEMINI_API_KEY=your_gemini_api_key_here
